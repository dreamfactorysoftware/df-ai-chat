{
    "name": "dreamfactory/df-ai-chat",
    "description": "Chat with your DreamFactory data using AI and MCP tools",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "dreamfactory/df-ai": "*",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "DreamFactory\\Core\\AIChat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DreamFactory\\Core\\AIChat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DreamFactory\\Core\\AIChat\\ServiceProvider"
            ]
        }
    }
}
